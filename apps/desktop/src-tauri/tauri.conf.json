{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Croc Transfer",
  "version": "0.1.0",
  "identifier": "com.croctransfer.prototype",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Croc Transfer",
        "width": 720,
        "height": 760,
        "minWidth": 400,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "externalBin": ["binaries/croc"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
